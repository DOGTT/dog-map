/* pages/mine.wxss */

/* 页面容器 */
.root {
    display: flex;
    flex-direction: column;
    height: 100vh;
    /* 占满整个屏幕高度 */
    width: 100vw;
    /* 宽度设置为全屏宽度 */
    position: relative;
    overflow: hidden;
}

/* 上部分 */
.user-info-section {
    display: flex;
    /* align-items: center; */
    /* justify-content: center; */
    background: linear-gradient(to top, #C3D825, #00BFFF);
    /* 渐变色背景 */
    color: white;
    font-size: 36rpx;
    flex-direction: column;
    padding-top: 30px;
}


/* 狗狗头像 */
.dog-avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    /* 圆形头像 */
    border: 2rpx solid #f0f0f0;
    /* 灰色边框 */
    object-fit: cover;
    /* 确保图片比例 */
}

/* 狗狗信息卡片整体 */
.dog-info-card {
    display: flex;
    gap: 30rpx;
    /* 调整头像与信息的间距 */
    /* padding: 30rpx; */
    /* background-color: #fff; */
    /* border-radius: 24rpx; */
    /* 卡片圆角 */
    /* box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15); */
    /* 卡片阴影 */
    margin: 20rpx;
    margin-top: 80rpx;
    align-items: center;
    /* background-color: #fff; */
    /* 卡片圆角 */

    /* 垂直居中 */
}

/* 狗狗头像 */
.dog-avatar {
    width: 180rpx;
    height: 180rpx;
    border-radius: 50%;
    /* 圆形头像 */
    border: 4rpx solid #f0f0f0;
    background-color: #FFF;
    /* 灰色边框 */
    object-fit: cover;
    /* 确保图片比例 */
    box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
    /* 头像阴影 */
}

/* 狗狗信息容器 */
.dog-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12rpx;
    /* 信息间距 */
}

/* 狗狗名字 */
.dog-name {
    font-size: 40rpx;
    font-weight: bold;
    color: #FFF;
    display: flex;
    align-items: center;
    gap: 8rpx;
    /* 与 emoji 的间距 */
}

/* 狗狗详细信息 */
.dog-detail-item {
    font-size: 24rpx;
    color: #eee;
    display: flex;
    align-items: center;
}

.info-tags {
    display: flex;
    gap: 10rpx;
}

/* 按钮容器 */
.info-buttons {
    display: flex;
    justify-content: space-around;
    margin: 20rpx 30rpx 0;
}

/* 单个按钮 */
.info-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* width: 80rpx; */
    /* height: 80rpx; */
    margin: 20rpx;
    margin-bottom: 40rpx;
    /* background-color: #fff; */
    /* border-radius: 16rpx; */
    /* box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1); */
}

/* 按钮数字 */
.info-number {
    font-size: 28rpx;
    /* font-weight: bold; */
    color: #FFF;
}

/* 按钮文字 */
.info-label {
    font-size: 26rpx;
    color: #FFF;
}



.user-sum-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.config-zone {
    width: 200rpx;
    background-color: transparent;
    padding-right: 20rpx;
}

.config-btn {
    width: 150rpx !important;
    background-color: transparent !important;
}


/* 吸顶标签栏 */
.sticky-tab-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    width: 100%;
    display: flex;
    justify-content: space-around;
    /* align-items: center; */
    height: 80rpx;
    background-color: #fff;
    box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
    border-bottom: 1rpx solid #eee;
    border-top-left-radius: 30rpx;
    border-top-right-radius: 30rpx;
}

/* 标签项 */
.tab-item {
    flex: 1;
    text-align: center;
    font-size: 32rpx;
    line-height: 80rpx;
    color: #666;
    width: 100rpx;
    /* cursor: pointer; */
}

/* 激活状态 */
.tab-item.active {
    color: #333;
    font-weight: bold;
}

/* 下划线 */
.underline {
    position: absolute;
    bottom: 0;
    width: 33.333%;
    /* 每个标签的宽度 */
    height: 4rpx;
    background-color: #FFD700;
    transition: left 0.3s ease;
}

/* 下部分 */
.bottom-section {
    flex: 1;
    overflow: hidden;
    padding: 0 20rpx;
    height: calc(100vh - 600rpx);
    /* 设置固定高度，减去头部高度 */
}

.waterfall-container {
    display: flex;
    justify-content: space-between;
    padding: 20rpx 0;
    width: 100%;
    box-sizing: border-box;
}

.waterfall-column {
    flex: 1;
    width: 48%;
    /* 设置固定宽度，留出间距 */
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    /* 卡片之间的间距 */
}

.waterfall-column:first-child {
    margin-right: 4%;
    /* 两列之间的间距 */
}

/* 确保卡片宽度正确 */
.item-card {
    width: 100%;
    box-sizing: border-box;
}

.loading-status {
    width: 100%;
    height: 80rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #999;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 30rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
    text-align: center;
}