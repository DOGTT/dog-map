/* head ====== */


/* ===== 底部控制栏 ====== */

/* 底部容器 */
.bottom-ctrl {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    /* z-index: 1000; */
}

.pub-button {
    bottom: 50rpx;
    left: 30rpx;
}

.pub-button-up {
    bottom: calc(50rpx + var(--card-height));
}

.mark-button {
    bottom: 150rpx;
    right: 30rpx;
}

.mark-button-up {
    bottom: calc(150rpx + var(--card-height));
}

.reloc-button {
    bottom: 50rpx;
    right: 30rpx;
}

.reloc-button-up {
    bottom: calc(50rpx + var(--card-height));
}

.rect-button {
    position: fixed;
    display: flex;
    width: 50px;
    height: 50px;
    background-color: #fcfcfc;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    transition: bottom 0.3s ease;
}


.rect-button:active {
    box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.2);
    background-color: #cfcfcf;
    /* 点击时的颜色变化 */
}

.rect-button-icon {
    width: 20px;
    height: 20px;
    margin-bottom: 3px;
}

.rect-button-text {
    font-size: 10px;
    color: #333;
}


/* 弹出框样式 */
.pofp-detail-popup {
    position: fixed;
    height: var(--card-height);
    bottom: calc(-1 * var(--card-height));
    left: 30rpx;
    right: 30rpx;
    border-radius: 15px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    /* margin: 20px 20px 20px 20px; */
    background-color: #ffffff;
    /* 默认隐藏 */
    /* transform: translateY(100%);  */
    transition: transform 0.3s ease, bottom 0.3s ease;
    /* z-index: 1000; */
}

.pofp-detail-popup-show {
    bottom: 30rpx;
    /* 弹出到可见区域 */
}

.pofp-detail-popup-hide {
    bottom: calc(-1 * var(--card-height));
    /* 隐藏回屏幕下方 */
}

.pofp-detail-card {
    display: flex;
    flex-direction: column;
    /* 等分为两行 */
    height: var(--card-height);
    border: 1px solid #ccc;
    border-radius: 10rpx;
    overflow: hidden;
    /* background-color: #ccc; */
}

/*NEW*/
.pofp-detail-card-head {
    /* background-color: #eee; */
    height: 120rpx;
    /* 固定头部高度 */
    /* width: 100%; */
    /* 宽度100% */
    padding: 5rpx 0rpx;
    display: flex;
    justify-content: space-between;
    margin: 0 15rpx;
    border-bottom: 1rpx solid #ddd;
}

.pofp-detail-card-head .meta-box {
    /* background-color: rgb(188, 198, 209); */
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* height: 80%; */
    /* width: 100%; */
}

.meta-title {
    color: #333;
    font-size: 40rpx;
    /* font-weight: bold; */
}

.meta-user-info {
    display: flex;
    align-items: center;
}

.meta-avatar {
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    /* 圆形效果 */
    border: 4rpx solid white;
    /* 白色边缘 */
}

.meta-name {
    color: #333;
    font-size: 28rpx;
}

.pofp-detail-card-head .ixn-box {
    /* background-color: rgb(22, 113, 204); */
    color: #333;
    /* padding: 20rpx; */
    gap: 30rpx;
    display: flex;
    padding-right: 20rpx;
    /* height: 80%; */
    /* width: 100%; */
    /* font-size: 50rpx; */
}

.inx-icon-info {
    background-color: #228B22 !important;
    transition: fill 0.3s;
}

.pofp-detail-card-body {
    display: grid;
    background-color: #eee;
    width: 100%;
    height: calc(100% - 120rpx);
    padding: 10rpx 10rpx;
    grid-template-rows: 1fr 80rpx;
    /* 2行，每行高度相等 */
    grid-template-columns: repeat(3, 1fr);
    /* 3列，每列宽度相等 */
    gap: 10rpx;
    /* 格子之间的间距 */
}

.pofp-detail-media-zone {
    background-color: hsl(91, 65%, 57%);
    border: 1px solid #eee;
    border-radius: 5px;
    grid-row: span 2;
    display: flex;
    overflow: hidden;
}

.media-key-photo {
    width: 100%;
    /* 占满容器宽度 */
    height: 100%;
    /* 占满容器高度 */
    object-fit: cover;
}


.pofp-detail-dynamic-zone {
    background-color: hsl(91, 15%, 70%);
    border: 1px solid #eee;
    border-radius: 5px;
    grid-column: span 2;
}

.pofp-detail-location-zone {
    background-color: #eee;
    border: 1px solid #eee;
    border-radius: 5px;
    grid-column: span 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.location-text {
    font-size: 24rpx;
    color: #444;
}

.pofp-detail-location-zone .location-nav-button {
    display: flex;
    align-items: center;
    padding-right: 10rpx;
}

.nav-icon {
    width: 50rpx;
    height: 50rpx;
}

.nav-text {
    color: #555;
    font-size: 38rpx;
}


.favorite-icon {
    width: 38rpx;
    /* 图标大小 */
    height: 38rpx;
    margin-left: 20rpx;
    cursor: pointer;
    /* 鼠标指针样式 */
    transition: fill 0.3s;
    /* 颜色切换过渡效果 */
}