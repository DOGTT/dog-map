<!--pages/map/map.wxml-->
<view class="full-screen">
  <view id="map-container">
    <!-- 地图 -->
    <map id="map" class="full-screen" latitude="{{mapData.latitude}}" longitude="{{mapData.longitude}}" scale="{{mapData.scale}}" setting="{{mapSetting}}" markers="{{mapData.markers}}" circles="{{mapData.circles}}" bindtap="onTapMap" bindtouchstart="onMapTouchStart" bindtouchend="onMapTouchEnd" bindregionchange="onChangeRegion" bindpoitap="onTapPoi" bindlabeltap="onLabelTap" bindcallouttap="onCalloutTap" bindmarkertap="onTapMarker">
    </map>
    <view class="head-zone" style="{{headZoneStyle}}">
      <!-- 搜索 -->
      <van-search custom-class="search-input" background="ragb(0,0,0,0)" value="{{ value }}" placeholder="点击选择位置" bind:focus="onSearchFocus" />
      <!-- 上方类型tab -->
      <scroll-view class="channel-type-selecter-scroll-view" scroll-x="true" bindscroll="scroll" style="width: 100%">
        <view class="channel-type-tab-button-container">
          <block wx:for="{{ channelTypeList }}" wx:key="id">
            <van-button plain size="small" icon="{{channelTypeStateMap[item.id].icon}}" icon-size="54px" type="primary" data-id="{{item.id}}" class="channel-type-button" custom-class="channel-type-button-custom {{channelTypeStateMap[item.id].select ? 'selected' : 'default'}}" bind:tap="onChannelTypeButtonClick">{{item.name}}</van-button>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- 下方控制展示区 -->
    <view class="bottom-ctrl">
      <!-- 发布按钮 -->
      <view class="rect-button pub-button {{channelDetailCard.show  ? 'pub-button-up' : ''}}" style="{{channelDetailCard.show ? 'bottom: calc(60rpx + ' + buttonOffset + 'px)' : ''}}" bindtap="navigateToChannelCreate">
        <image src="/static/svg/pub.svg" class="rect-button-icon" />
        <text class="rect-button-text">发布</text>
      </view>
      <!-- 标记按钮 -->
      <view class="rect-button mark-button {{channelDetailCard.show  ? 'mark-button-up' : ''}}" style="{{channelDetailCard.show ? 'bottom: calc(180rpx + ' + buttonOffset + 'px)' : ''}}" bindtap="">
        <image src="/static/svg/mark.svg" class="rect-button-icon" />
        <text class="rect-button-text">打卡</text>
      </view>
      <!-- 定位按钮 -->
      <view class="rect-button reloc-button {{channelDetailCard.show  ? 'reloc-button-up' : ''}}" style="{{channelDetailCard.show ? 'bottom: calc(60rpx + ' + buttonOffset + 'px)' : ''}}" bindtap="moveViewToLocation">
        <image src="/static/svg/location.svg" class="rect-button-icon" />
        <text class="rect-button-text">定位</text>
      </view>
      <!-- 弹出框 -->
      <view class="channel-detail-popup {{channelDetailCard.show  ? 'channel-detail-popup-show' : 'channel-detail-popup-hide'}}">
        <view class="channel-detail-card">
          <!-- 第一行：大标题 + 类型+位置信息 -->
          <view class="channel-detail-header">
            <view class="title-container">
              <text class="title-text" bindtap="navToChannelPage">{{channelDetailCard.data.title}}</text>
              <view class="info-container">
                <text class="type-text">{{channelDetailCard.data.type || '类型'}}</text>
                <text class="separator">·</text>
                <text class="location-text">{{channelDetailCard.shortAddress}}</text>
              </view>
            </view>
          </view>
          
          <!-- 第三行：标签 -->
          <view class="channel-detail-tags">
            <text class="tag-item">大狗狗</text>
            <text class="tag-item">友好</text>
            <text class="tag-item">活跃</text>
          </view>
          
          <!-- 第四行：简介 -->
          <view class="channel-detail-intro">
            <text class="intro-text">{{channelDetailCard.data.intro || '这是一个简介信息，超过一行会显示省略号...'}}</text>
          </view>
          
          <!-- 第五行：状态数据和导航 -->
          <view class="channel-detail-footer">
            <view class="status-data">
              <text class="status-item">成员数量: {{channelDetailCard.data.memberCount || 100}}</text>
              <text class="status-item">互动数: {{channelDetailCard.data.interactionCount || 199}}</text>
            </view>
            <view class="location-nav-button">
              <image class="nav-icon" src="/static/nav.png" />
              <text class="nav-text">{{channelDetailCard.distance}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <!-- end -->
  </view>

  <!-- channel详情页面 -->
  <view>

  </view>
  <!-- 登陆注册页 -->
  <login-popup show="{{loginPopupShow}}" bind:close="onLoginPopupClose" bind:login="onUserLogin" />
</view>