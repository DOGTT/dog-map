/* pages/discover/discover.wxss */
.root {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background-color: #f8f8f8;
    padding-top: 46px;
    /* 为van-nav-bar预留空间 */
}

.header {
    position: fixed;
    top: 46px;
    /* 调整位置，避免与van-nav-bar重叠 */
    left: 0;
    right: 0;
    height: 44px;
    display: flex;
    align-items: center;
    padding: 0 15px;
    z-index: 100;
}

.body {
    flex: 1;
    padding: 20rpx;
    overflow-y: auto;
    padding-bottom: 30rpx;
    /* 为底部留出空间 */
}

.discover-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.discover-card {
    width: 48%;
    margin-bottom: 20rpx;
    background-color: #fff;
    border-radius: 12rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
}

.discover-card:active {
    transform: scale(0.98);
    box-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.1);
}

.card-image {
    width: 100%;
    height: 300rpx;
    display: block;
}

.card-content {
    padding: 16rpx;
}

.card-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 8rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.card-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.card-author {
    font-size: 24rpx;
    color: #999;
}

.card-likes {
    display: flex;
    align-items: center;
}

.like-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 6rpx;
}

.card-likes text {
    font-size: 24rpx;
    color: #999;
}

.tail {
    height: 30rpx;
    background-color: #f8f8f8;
}