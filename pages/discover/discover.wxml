<!--pages/discover/discover.wxml-->
<view class="root">
	<van-nav-bar
		title="发现"
		fixed
	/>
	<!-- 头部固定 -->
	<view class="header">
	</view>
	<!-- <text class="content">👷系统施工中...</text> -->
	<!-- 主内容区 -->
	<view class="body">
		<view class="discover-grid">
			<block wx:for="{{discoverCards}}" wx:key="id">
				<view class="discover-card" bindtap="navigateTo{{item.id === 1 ? 'NearbyDogs' : item.id === 2 ? 'Square' : item.id === 3 ? 'Random' : 'AIDogs'}}">
					<image class="card-image" src="{{item.image}}" mode="aspectFill"></image>
					<view class="card-content">
						<text class="card-title">{{item.title}}</text>
						<view class="card-info">
							<text class="card-author">{{item.author}}</text>
							<view class="card-likes">
								<image class="like-icon" src="/static/images/like.png"></image>
								<text>{{item.likes}}</text>
							</view>
						</view>
					</view>
				</view>
			</block>
		</view>
	</view>

	<!-- 尾部固定 -->
	<view class="tail">
	</view>
</view>