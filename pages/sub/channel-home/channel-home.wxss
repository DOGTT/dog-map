/* pages/sub/channel-home/channel-home.wxss */
.root {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background-color: #f5f5f5;
}

.header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 88rpx;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    z-index: 100;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.back-icon {
    width: 48rpx;
    height: 48rpx;
}

.body {
    flex: 1;
    padding: 30rpx;
    overflow: hidden;
    /* margin-top: 88rpx; */
}

/* 标题和类型信息 */
.channel-detail-header {
    margin-bottom: 20rpx;
    background-color: #ffffff;
    padding: 30rpx;
    border-radius: 12rpx;
}

.title-container {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.title-row {
    display: flex;
    align-items: center;
}

.title-text {
    font-size: 36rpx;
    font-weight: bold;
    color: #333333;
}

.type-text {
    font-size: 24rpx;
    color: #4CAF50;
    margin-right: 10rpx;
}

.separator {
    color: #999999;
    margin: 0 10rpx;
}

.tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
}

.tag-item {
    font-size: 22rpx;
    color: #666666;
    background-color: #f0f0f0;
    padding: 4rpx 12rpx;
    border-radius: 4rpx;
}

.status-data {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.status-item {
    display: flex;
    align-items: center;
}

.status-count {
    font-size: 24rpx;
    color: #666666;
    margin-left: 8rpx;
}

.status-separator {
    color: #999999;
}

.location-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.location-text {
    font-size: 24rpx;
    color: #666666;
}

.location-nav-button {
    display: flex;
    align-items: center;
    background-color: #4CAF50;
    padding: 10rpx 20rpx;
    border-radius: 8rpx;
}

.nav-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 8rpx;
}

.nav-text {
    font-size: 24rpx;
    color: #ffffff;
}

.intro-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 10rpx;
    padding: 20rpx;
    background-color: #f8f8f8;
    border-radius: 12rpx;
}

.intro-content {
    flex: 1;
    margin-right: 20rpx;
    min-height: 80rpx;
}

.intro-text {
    font-size: 28rpx;
    color: #666666;
    line-height: 1.6;
    word-break: break-all;
    white-space: pre-wrap;
}

.intro-input {
    font-size: 28rpx;
    color: #333333;
    line-height: 1.6;
    width: 100%;
    padding: 16rpx;
    border: 2rpx solid #e8e8e8;
    border-radius: 8rpx;
    background-color: #ffffff;
    min-height: 80rpx;
    box-sizing: border-box;
}

.intro-actions {
    display: flex;
    align-items: flex-start;
    padding-top: 8rpx;
}

.action-buttons {
    display: flex;
    align-items: center;
    gap: 10rpx;
}

.save-btn {
    margin-right: 10rpx;
}

.cancel-btn {
    background-color: #f5f5f5;
    color: #666666;
}

/* 滑动tab */
.tab-container {
    background-color: #ffffff;
    border-radius: 12rpx;
    margin-bottom: 20rpx;
}

.tabs {
    display: flex;
    border-bottom: 2rpx solid #f0f0f0;
}

.tab {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: 28rpx;
    color: #666666;
    position: relative;
}

.tab.active {
    color: #4CAF50;
    font-weight: bold;
}

.tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40rpx;
    height: 4rpx;
    background-color: #4CAF50;
}

.content-scroll {
    height: calc(100vh - 600rpx);
}

/* 成员列表 */
.members-list {
    background-color: #ffffff;
    border-radius: 12rpx;
    padding: 20rpx;
}

.member-item {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 2rpx solid #f0f0f0;
}

.member-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}

.member-info {
    flex: 1;
}

.member-name {
    font-size: 28rpx;
    color: #333333;
    font-weight: bold;
}

.member-role {
    font-size: 24rpx;
    color: #999999;
    margin-top: 4rpx;
}

.member-activity {
    font-size: 24rpx;
    color: #4CAF50;
}

/* 其他列表样式保持不变 */
.essence-list,
.links-list,
.media-list {
    background-color: #ffffff;
    border-radius: 12rpx;
    padding: 20rpx;
}

.essence-item,
.link-item {
    padding: 20rpx 0;
    border-bottom: 2rpx solid #f0f0f0;
}

.essence-title,
.link-title {
    font-size: 28rpx;
    color: #333333;
    font-weight: bold;
    margin-bottom: 10rpx;
}

.essence-content,
.link-url {
    font-size: 26rpx;
    color: #666666;
}

.media-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10rpx;
}

.media-item {
    width: 100%;
    height: 200rpx;
    border-radius: 8rpx;
}

/* 尾部固定 */
.tail {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: #ffffff;
    padding: 20rpx 30rpx;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
    padding-bottom: 20px;
}

.join-btn {
    background-color: #4CAF50;
    color: #ffffff;
    font-size: 32rpx;
    padding: 20rpx 0;
    border-radius: 8rpx;
    text-align: center;
    border: none;
    width: 100%;
}

.join-btn.joined {
    background-color: #ffffff;
    color: #4CAF50;
    border: 2rpx solid #4CAF50;
}