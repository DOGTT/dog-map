<!--pages/sub/user-edit/user-edit.wxml-->
<view class="root">
  <navigation-bar title="用户协议" back="{{false}}" color="black"></navigation-bar>
  <view class="header">
    <image class="back-icon" src="/static/png/return.png" bindtap="goBack" />
    <text class="header-title">资料编辑</text>
  </view>
  <scroll-view class="body">

    <!-- 头像 -->
    <!-- <view class="avatar-container">

      <image class="avatar" src="/static/png/avatar.png" />
    </view> -->
    <van-cell-group inset>
      <!-- 名字 -->
      <van-field value="{{ name }}" label="名字" placeholder="请输入名字" bind:change="onChange" />
      <!-- 简介 -->
      <van-field value="{{ intro }}" label="简介" placeholder="请输入简介内容" bind:change="onChange" autosize />
      <van-field value="{{ genderText[gender] }}" label="性别" placeholder="" bind:tap="onGenderTap" readonly is-link />
      <van-radio-group value="{{ gender }}" wx:if="{{genderBoxShow}}">
        <van-cell-group>
          <van-cell title="{{genderText[1]}}" clickable data-id="1" bind:click="onGenderSelected">
            <van-radio slot="right-icon" name="1" />
          </van-cell>
          <van-cell title="{{genderText[2]}}" clickable data-id="2" bind:click="onGenderSelected">
            <van-radio slot="right-icon" name="2" />
          </van-cell>
        </van-cell-group>
      </van-radio-group>
      <van-field value="{{ weightSizeSimpleText[weightSize] }}" label="体型" placeholder="" bind:tap="onWeightSizeTap" readonly is-link />
      <van-radio-group value="{{ weightSize }}" wx:if="{{weightSizeBoxShow}}">
        <van-cell-group>
          <block wx:for="{{ weightSizeText }}">
            <block wx:if="{{index !== 0}}">
              <van-cell title="{{weightSizeText[index]}}" clickable data-id="{{index}}" bind:click="onWeightSizeSelected">
                <van-radio slot="right-icon" name="{{index}}" />
              </van-cell>
            </block>
          </block>
        </van-cell-group>
      </van-radio-group>
      <!-- 生日 -->
      <van-field value="{{birthday}}" label="出生日期" placeholder="2022-01-01" bind:change="onChange" is-link readonly bind:tap="onBirthDayTap" />
      <!-- 品种 -->
      <van-field value="{{ breed }}" label="品种" placeholder="" bind:change="onChange" bind:tap="onBirthClick" />
    </van-cell-group>

    <van-popup show="{{ datePickerShow }}" bind:close="ondatePickerClose" round position="bottom">
      <van-datetime-picker type="date" title="划动选择生日" show-toolbar="false" value="{{ currentDate }}" max-date="{{minDate}}" formatter="{{ formatter }}" confirm-button-text="" bind:input="onInput" />
    </van-popup>
  </scroll-view>

  <view class="tail">
    <button class="save-button">保存</button>
    <!-- <van-button block class="save-button" style="width: 800px;" type="primary" round>保存</van-button> -->
  </view>
</view>