<view class="root">
	<view class="header">
		<van-nav-bar class="nav" title="频道主页" left-text="返回" left-arrow bind:click-left="goBack" fixed></van-nav-bar>
		<!-- 横幅区 -->
		<view class="banner">
			<view class="status-data">
				<view class="status-item">
					<van-icon name="chat-o" size="36rpx" />
					<text class="status-count">9</text>
				</view>
				<text class="status-separator">|</text>
				<view class="status-item">
					<van-icon name="/static/svg/mark.svg" size="36rpx" />
					<text class="status-count">13</text>
				</view>
				<text class="status-separator">|</text>
				<view class="status-item">
					<van-icon name="like-o" color="#F00" size="36rpx" />
					<text class="status-count">5</text>
				</view>
			</view>
			<view class="location-nav-button">
				<image class="nav-icon" src="/static/png/nav.png" />
				<text class="nav-text">500m</text>
			</view>
		</view>
	</view>
	<!-- 内容 -->
	<scroll-view class="body" scroll-y>
		<post-bubble avatarUrl="/static/png/dog-undefine.png" username="用户名称" date="2025-02-18" images="{{['/static/test/test-photo.jpg', '/static/test/test-photo2.png']}}" text="这里是发布的内容" reactions="{{['👍', '❤️', '😄']}}" bind:reactiontap="onReactionTap" />

		<post-bubble avatarUrl="/static/png/dog-undefine.png" username="用户名称" date="2025-02-18" images="{{['/static/test/test-photo.jpg', '/static/test/test-photo2.png']}}" text="这里是发布的内容" reactions="{{['👍', '❤️', '😄']}}" bind:reactiontap="onReactionTap" />


		<view>
			---------
		</view>
	</scroll-view>


	<!-- 评论互动区 -->
	<view class="tail">
		<view class="input-container" style="bottom: {{inputBottom}};">
			<textarea class="chat-input" show-confirm-bar="{{false}}" fixed cursor-spacing="10" auto-height maxlength="300" value="" placeholder="分享在此地的最新见闻" placeholder-style="fontSize:15px" />
			<view class="input-tail">
				<view class="media-uploader-box" wx:if="{{imageForUpload.length>0}}">
					<van-uploader file-list="{{ imageForUpload }}" max-count="3" preview-full-image="{{true}}" bind:after-read="onAfterRead" bind:delete="onDeleteImage" />
				</view>
				<view class="input-ctrl-box">
					<view class="inx-zone">
						<van-uploader max-count="3" bind:after-read="onAfterRead">
							<van-icon class="inx-icon" name="photo-o" />
						</van-uploader>
					</view>
					<button class="send-button" size="mini" bindtap="sendMessage"> 发送 </button>
				</view>

			</view>

		</view>
	</view>
</view>