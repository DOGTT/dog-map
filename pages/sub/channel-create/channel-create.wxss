.root {
	display: flex;
	flex-direction: column;
	height: 100vh;
	background-color: #fcfcfc;
	padding-top: 46px;
	/* 为van-nav-bar预留空间 */
}

.header {
	/* position: fixed; */
	/* top: 46px; 
  left: 0;
  right: 0;
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 15px;
  z-index: 100; */
}

.body {
	flex: 1;
	padding: 20rpx;
	padding-top: 120rpx;
	overflow-y: auto;
	padding-bottom: 30rpx;
}

.tail {
	height: 20px;
}

.header-title {
	font-size: 38rpx;
	font-weight: bold;
	color: #333;
}

.scroll-content {
	margin-top: 20rpx;
	height: calc(100vh - 80rpx);
	/* 扣除顶部标题栏的高度 */
	overflow-y: scroll;
	font-size: 28rpx;
	line-height: 40rpx;
	color: #333;
	height: 100vh;
	/* 占满整个屏幕高度 */
	display: flex;
	flex-direction: column;
	/* 页面分为上下布局 */
}

/* 页面整体样式 */

/* 内容区域样式 */
.content-grid {
	flex: 1;
	/* 内容部分占据剩余空间 */
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	/* 3列等宽 */
	gap: 20rpx;
	/* 网格间距 */
	padding: 20rpx;
	background-color: #f5f5f5;
	/* 背景色 */
}

.grid-item {
	height: 220rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #fff;
	border: 1px solid #ddd;
	border-radius: 10rpx;
	box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 底部按钮栏 */
.bottom-bar {
	display: flex;
	justify-content: space-between;
	/* 两个按钮左右分布 */
	align-items: center;
	padding: 20rpx;
	padding-bottom: 40rpx;
	background-color: #eee;
	border-top: 1px solid #e5e5e5;
	position: fixed;
	/* 固定在底部 */
	bottom: 0;
	left: 0;
	width: 100%;
	box-shadow: 0 -2rpx 5rpx rgba(0, 0, 0, 0.1);
}

/* 按钮样式 */
.save-button {
	background-color: #ccc;
	color: #333;
	border: none;
	border-radius: 8rpx;
	/* padding: 15rpx 80rpx; */
	font-size: 28rpx;
}

.publish-button {
	background-color: #FFBF00;
	color: #ffffff;
	border: none;
	border-radius: 8rpx;
	/* padding: 15rpx 80rpx; */
	font-size: 28rpx;
}

/* 照片选择区域 */
.photo-selection {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	/* 自动换行 */
	gap: 10rpx;
	padding: 16rpx;
	background-color: #fafafa;
	border-radius: 12rpx;
	margin-bottom: 20rpx;
}

.photo-wrapper {
	width: 150rpx;
	height: 150rpx;
	border-radius: 10rpx;
	overflow: hidden;
	position: relative;
}

.photo {
	width: 100%;
	height: 100%;
	/* object-fit: cover; */
}

.add-photo-button {
	width: 150rpx;
	height: 150rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 48rpx;
	color: #999;
	background-color: #f0f0f0;
	border: 1px dashed #ddd;
	border-radius: 10rpx;
}

/* 标题输入栏 */
.title-input-wrapper {
	display: flex;
	align-items: center;
	margin-bottom: 20rpx;
	margin-top: 0;
	position: relative;
}

.title-input {
	flex: 1;
	height: 80rpx;
	border: none;
	border-bottom: 2rpx solid #FFBF00;
	padding: 0 20rpx;
	font-size: 32rpx;
	background-color: transparent;
	transition: all 0.3s ease;
}

.title-input:focus {
	outline: none;
	border-bottom: 2rpx solid #FFBF00;
	box-shadow: 0 2rpx 4rpx rgba(255, 191, 0, 0.1);
}

/* 标签选择区域 */
.type-selection {
	display: flex;
	flex-direction: column;
	margin-bottom: 20rpx;
	padding: 16rpx 0;
	white-space: nowrap;
	overflow-x: auto;
	/* border-bottom: 1px solid #FFBF00; */
}

.type-hint-container {
	display: flex;
	align-items: center;
	margin-bottom: 20rpx;
}

.type-hint {
	font-size: 28rpx;
	color: #333;
	font-weight: bold;
	display: inline-block;
	padding: 10rpx 0;
}

.type-hint-desc {
	font-size: 26rpx;
	color: #666;
	display: inline-block;
	margin-left: 20rpx;
}

.type-list {
	display: flex;
	width: 100%;
	flex-wrap: nowrap;
}

.type-buttons-container {
	display: flex;
	flex-wrap: nowrap;
	overflow-x: auto;
	padding: 10rpx 0;
}

.type-button {
	display: flex;
	font-size: 28rpx;
	border-radius: 20rpx;
	border: 1px solid #ddd;
	color: #eee;
	background-color: rgb(161, 161, 161);
	padding: 10rpx 20rpx;
	margin-right: 20rpx;
	transition: all 0.3s ease-in-out;
	margin-bottom: 10rpx;
	white-space: nowrap;
}

.type-button.selected {
	color: #fff;
	background-color: #FFBF00;
	transform: scale(1.1);
	/* 选中时稍微放大 */
}

/* 内容输入栏 */
.content-input-wrapper {
	display: flex;
	margin-bottom: 20rpx;
}

.content-input {
	width: 100%;
	height: 200rpx;
	border: 1px solid #FFBF00;
	border-radius: 12rpx;
	padding: 20rpx;
	font-size: 28rpx;
	overflow-y: auto;
}

/* 地点选择框 */
.location-container {
	margin-top: 16rpx;
	/* border: 1px solid #FFBF00; */
	border-radius: 12rpx;
	overflow: hidden;
}

.location-info {
	font-size: 28rpx;
	color: #333;
	background-color: #f9f9f9;
	border-bottom: 1px solid #FFBF00;
}

.location-info-text {
	color: #333;
	font-weight: bold;
}

.location-map {
	width: 100%;
	/* height: 100%; */
}

/* 区块标题样式 */
.section-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 6rpx;
	position: relative;
	padding-bottom: 10rpx;
	display: inline-block;
}

.section-title::after {
	/* content: '';
	position: absolute;
	bottom: 0;
	left: 0;
	width: 100%;
	height: 5rpx;
	background-color: #FFBF00; */
}

.section-desc {
	font-size: 26rpx;
	color: #666;
	margin-bottom: 20rpx;
	display: inline-block;
	margin-left: 20rpx;
}

/* 频道初始化区块样式 */
.channel-init {
	background-color: #fff;
	padding: 24rpx;
	margin-bottom: 24rpx;
	border-radius: 16rpx;
	position: relative;
}

.channel-init::after {
	content: '';
	position: absolute;
	bottom: -12rpx;
	left: 0;
	right: 0;
	height: 1px;
	background: linear-gradient(to right, transparent, #eee, transparent);
}

/* 首条推文区块样式 */
.post-first {
	background-color: #fff;
	padding: 24rpx;
	margin-bottom: 24rpx;
	border-radius: 16rpx;
}
