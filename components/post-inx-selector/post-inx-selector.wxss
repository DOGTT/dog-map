.tag-selector {
    padding: 30rpx;
    max-height: 80vh;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.close-icon {
    font-size: 40rpx;
    color: #999;
}

.content {
    margin-bottom: 30rpx;
}

.section {
    margin-bottom: 30rpx;
    padding-bottom: 30rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.section:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.section-title {
    font-size: 28rpx;
    color: #666;
    margin-bottom: 20rpx;
    display: block;
}

.emoji-list {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}

.emoji-item {
    width: 80rpx;
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f0f0f0;
    border-radius: 40rpx;
    padding: 10rpx;
}

.emoji-item.selected {
    background-color: #4A90E2;
}

.emoji-image {
    width: 60rpx;
    height: 60rpx;
}

.tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}

.tag-item {
    padding: 10rpx 20rpx;
    background-color: #fff;
    border: 2rpx solid #4A90E2;
    border-radius: 8rpx;
    font-size: 32rpx;
    color: #4A90E2;
}

.tag-item.selected {
    background-color: #4A90E2;
    color: #fff;
}

.create-tag-btn {
    padding: 10rpx 20rpx;
    background-color: #fff;
    border: 2rpx solid #4A90E2;
    border-radius: 8rpx;
    font-size: 26rpx;
    color: #4A90E2;
    display: inline-flex;
    align-items: center;
    gap: 10rpx;
    margin-left: 20rpx;
}

.create-tag-btn::before {
    content: "+";
    font-size: 30rpx;
}

.create-tag-input {
    flex: 1;
    margin-left: 20rpx;
}

.create-tag-input input {
    width: 100%;
    height: 60rpx;
    background-color: #f0f0f0;
    border-radius: 8rpx;
    padding: 0 20rpx;
    font-size: 26rpx;
}

.footer {
    margin-top: 30rpx;
}