<!--components/item-card/item-card.wxml-->
<view class="item-card">
  <view class="item-card-media">
    <image class="media-key-photo" src="/static/test/test-photo.jpg" mode="scaleToFill" />
  </view>
  <text class="item-card-title">{{title|| '标题'}}</text>
  <view class="item-card-tail">
    <view class="author-info">
      <image class="author-avatar" src="{{coverImage || '/static/png/dog-13.png'}}" />
      <text class="author-name">香香</text>
    </view>
    <view class="ixn-info">
      <view class="ixn-item">
        <van-icon name="like-o" color="#F00" size="30rpx" />
        <text class="ixn-text">10</text>
      </view>
    </view>
  </view>
</view>