/* components/post-bubble/post-bubble.wxss */
.message-bubble {
  display: flex;
  width: 100%;
  align-items: flex-start;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 20px;
  /* align-items: flex-end; */
}

.avatar-zone {
  width: 80rpx;
  height: 80rpx;
  border: 1px solid #eee;
  border-radius: 50%;
  margin: 10rpx;
  overflow: hidden;
}


.bubble {
  flex: 1;
  min-width: 0; 
  background-color: #f0f0f0;
  border-radius: 10px;
  margin-right: 10px;
  padding: 10px;
}

.header {
  margin-bottom: 10px;
}

.user-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 5px;
}

.username {
  font-weight: bold;
}

.date {
  color: #999;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background-color: #0066ff;
  color: #fff;
  border-radius: 5px;
  padding: 2px 5px;
  margin-right: 5px;
  font-size: 12px;
}

.content {
  margin-bottom: 10px;
  position: relative;
}

.swiper-container {
  position: relative;
  /* border-radius: 8px; */
  border-radius: 20rpx;
  overflow: hidden;
}

.image-swiper {
  width: 100%;
  height: 80vw;
}

.swiper-image {
  width: 100%;
  height: 100%;
  /* object-fit: cover; */
  border-radius: 20rpx;
}



.index-indicator {
  position: absolute;
  top: 10px;
  right: 10px;
  background-color: rgba(0, 0, 0, 0.5);
  color: white;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 12px;
}

.text {
  width: 100%;
  margin-top: 10px;
}

.content text {
  font-size: 14px;
}

.footer {
  display: flex;
  justify-content: flex-end;
}

.footer button {
  margin-left: 10px;
  background-color: transparent;
  border: none;
  font-size: 14px;
  color: #007aff;
}