/* components/post-bubble/post-bubble.wxss */
.message-bubble {
    display: flex;
    width: 100%;
    align-items: flex-start;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
    margin-bottom: 20px;
}

.avatar-zone {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin: 10rpx;
    overflow: hidden;
}

.bubble {
    flex: 1;
    min-width: 0;
    background-color: #fff;
    border-radius: 10px;
    margin-right: 10px;
    padding: 10px;
}

.header {
    margin-bottom: 10rpx;
}

.user-info {
    display: flex;
    gap: 10rpx;
    margin-bottom: 5px;
}

.username {
    font-weight: bold;
    color: #333;
}

.date {
    color: #999;
    font-size: 24rpx;
}

.content {
    margin-bottom: 10px;
    position: relative;
}

.swiper-container {
    position: relative;
    border-radius: 20rpx;
    overflow: hidden;
}

.image-swiper {
    width: 100%;
    height: 80vw;
}

.swiper-image {
    width: 100%;
    height: 100%;
    border-radius: 20rpx;
}

.index-indicator {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 12px;
}

.text {
    display: block;
    width: 100%;
    margin: 10px 0px;
    font-size: 30rpx;
    color: #333;
    line-height: 1.5;
}

.footer {
    padding-top: 10rpx;
}

.interaction-container {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
    align-items: center;
}

.interaction-button {
    display: flex;
    align-items: center;
    padding: 8rpx 16rpx;
    border-radius: 30rpx;
    border: 1px solid #e0e0e0;
    background-color: #fff;
    transition: all 0.3s ease;
}

.interaction-button.active {
    background-color: #f0f0f0;
    border-color: #999;
}

.button-text {
    font-size: 24rpx;
    color: #333;
    margin-right: 8rpx;
}

.button-count {
    font-size: 24rpx;
    color: #666;
}

.sticker-image {
    width: 32rpx;
    height: 32rpx;
    margin-right: 8rpx;
}

.add-button {
    width: 40rpx;
    height: 40rpx;
    background-color: #f0f0f0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
}

.tags-container {
    display: flex;
    align-items: center;
    gap: 10rpx;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8rpx;
    flex: 1;
}

.tag {
    background-color: #f0f0f0;
    color: #666;
    border-radius: 6rpx;
    padding: 4rpx 12rpx;
    font-size: 24rpx;
}

.add-tag {
    width: 40rpx;
    height: 40rpx;
    background-color: #f0f0f0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
}