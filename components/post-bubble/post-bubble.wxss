/* components/post-bubble/post-bubble.wxss */
.message-bubble {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20px;
}

.avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 10px;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.bubble {
  flex: 1;
  background-color: #f0f0f0;
  border-radius: 10px;
  padding: 10px;
}

.header {
  margin-bottom: 10px;
}

.user-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 5px;
}

.username {
  font-weight: bold;
}

.date {
  color: #999;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background-color: #e0e0e0;
  border-radius: 5px;
  padding: 2px 5px;
  margin-right: 5px;
  font-size: 12px;
}

.content {
  margin-bottom: 10px;
}

.content image {
  width: 100%;
  height: 150px;
  margin-bottom: 10px;
  border-radius: 5px;
}

.content text {
  font-size: 14px;
}

.footer {
  display: flex;
  justify-content: flex-end;
}

.footer button {
  margin-left: 10px;
  background-color: transparent;
  border: none;
  font-size: 14px;
  color: #007aff;
}