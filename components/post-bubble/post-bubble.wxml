<!--components/post-bubble/post-bubble.wxml-->
<view class="message-bubble">
  <!-- 头像 -->
  <image class="avatar-zone" src="{{avatarUrl}}" mode="aspectFill"></image>

  <!-- 内容气泡 -->
  <view class="bubble">
    <!-- 头部区 -->
    <view class="header">
      <view class="user-info">
        <text class="username">{{username}}</text>
        <text class="date">{{date}}</text>
      </view>
    </view>

    <!-- 内容区 -->
    <view class="content">
      <text class="text">{{text}}</text>
      <!-- 轮播图 -->
      <view class="swiper-container">
        <swiper
          class="image-swiper"
          current="{{currentIndex}}"
          bindchange="onSwiperChange"
          autoplay="{{false}}"
          circular="{{false}}" indicator-dots="true" 
        >
          <block wx:for="{{images}}" wx:key="index">
            <swiper-item>
              <image class="swiper-image" src="{{item}}" mode="aspectFill"></image>
            </swiper-item>
          </block>
        </swiper>
        <!-- 角标 -->
        <view class="index-indicator">
          {{currentIndex + 1}}/{{images.length}}
        </view>
      </view>
    </view>

    <!-- 底部互动区 -->
    <view class="footer">
      <view class="interaction-container">
        <!-- 标签按钮 -->
        <block wx:for="{{tags}}" wx:key="key">
          <view class="interaction-button {{item.active ? 'active' : ''}}" bindtap="onTagClick" data-type="tag" data-index="{{index}}">
            <text class="button-text">{{item.key}}</text>
            <text class="button-count">{{item.count}}</text>
          </view>
        </block>
        
        <!-- 贴纸按钮 -->
        <block wx:for="{{stickers}}" wx:key="key">
          <view class="interaction-button {{item.active ? 'active' : ''}}" bindtap="onStickerClick" data-type="sticker" data-index="{{index}}">
            <image class="sticker-image" src="/static/svg/emoji/{{item.key}}.svg" mode="aspectFit"></image>
            <text class="button-count">{{item.count}}</text>
          </view>
        </block>
        
        <!-- 添加按钮 -->
        <view class="add-button" bindtap="onAddInteraction">
          <van-icon name="plus" size="24rpx" />
        </view>
      </view>
    </view>
  </view>
</view>

<post-inx-selector 
  show="{{showInteractionSelector}}"
  bind:close="onInteractionSelectorClose"
  bind:createtag="onCreateTag"
  bind:confirm="onInteractionSelectorConfirm"
/>